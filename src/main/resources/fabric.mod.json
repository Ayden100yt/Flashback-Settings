{
	"schemaVersion": 1,
	"id": "flashback-settings",
	"version": "${version}",
	"name": "Flashback Settings",
	"description": "A mod that adds more Flashback settings starting with changing the replay folder location and adding subfolders.",
	"authors": [
		"Ayden100"
	],
	"license": "MIT",
	"icon": "assets/flashback-settings/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.flashbacksettings.FlashbackSettings"
		],
		"client": [
			"com.flashbacksettings.client.FlashbackSettingsClient"
		]
	},
	"mixins": [
		"flashback-settings.mixins.json",
		{
			"config": "flashback-settings.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~${minecraft}",
		"java": ">=25",
		"fabric-api": "*",
		"flashback": ">=${flashback_min}"
	}
}
